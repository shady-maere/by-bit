{
  "name": "bybit-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Bybit clone frontend with Firebase Auth, Realtime Database, and Hosting",
  "scripts": {
    "dev": "npx serve -s . -l 3000",
    "build": "echo \"No build step required; static files served directly.\"",
